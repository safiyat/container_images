FROM ubuntu:noble

LABEL org.opencontainers.image.title="aria2c"
LABEL org.opencontainers.image.description="aria2 download utility with JSON-RPC/XML-RPC enabled and webui-aria2"
LABEL org.opencontainers.image.base.name="docker.io/library/ubuntu:noble"
LABEL org.opencontainers.image.licenses="GPL-2.0-or-later"

ARG WEBUI_ARIA2_COMMIT=6ef75d54d6f218992eb5b0f4df6d6466ce4fb25c

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        aria2 \
        ca-certificates \
        curl \
        nodejs \
    && groupadd --gid 1001 aria2 \
    && useradd --uid 1001 --gid aria2 --shell /usr/sbin/nologin --create-home aria2 \
    && curl -fsSL "https://github.com/safiyat/webui-aria2/archive/${WEBUI_ARIA2_COMMIT}.tar.gz" \
        -o /tmp/webui-aria2.tar.gz \
    && tar -xzf /tmp/webui-aria2.tar.gz -C /opt \
    && mv "/opt/webui-aria2-${WEBUI_ARIA2_COMMIT}" /opt/webui-aria2 \
    && rm -f /tmp/webui-aria2.tar.gz \
    && apt-get purge -y curl \
    && apt-get autoremove -y --purge \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=755 entrypoint.sh /usr/local/bin/aria2c-entrypoint

USER aria2

VOLUME /home/aria2/.aria2

WORKDIR /downloads

EXPOSE 6800
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/aria2c-entrypoint"]
